<?xml version="1.0" encoding="utf-8"?>
<Talents>
    <Talent identifier="Kagiyama_HinaTalent">
        <Icon texture="%ModDir%/Images/Talents/Kagiyama_HinaTalent.png" sheetindex="0,0" sheetelementsize="128,128"/>
        <Description tag="talentdescription.Kagiyama_HinaTalent"/>

        <AbilityGroupInterval interval="10.0">
            <Conditions>
                <AbilityConditionHasAffliction afflictionidentifier="Touhou_Kagiyama_Hina_Character_Effect"/>
            </Conditions>
            <Abilities>
                <CharacterAbilityApplyStatusEffects applytoself="true">
                    <StatusEffects>
                        <StatusEffect type="OnAbility" target="Character" disabledeltatime="true" multiplyafflictionsbymaxvitality="true">
                            <Affliction identifier="Touhou_Misfortune_Curse" strength="1.0"/>
                        </StatusEffect>
                    </StatusEffects>
                </CharacterAbilityApplyStatusEffects>
            </Abilities>
        </AbilityGroupInterval>

        <AbilityGroupEffect abilityeffecttype="OnAttack">
            <Conditions>
                <AbilityConditionHasAffliction afflictionidentifier="Touhou_Kagiyama_Hina_Character_Effect"/>
                <AbilityConditionAttackData tags="Touhou_Magic_Danmu" ignorenonharmfulattacks="true" weapontype="Ranged"/>
            </Conditions>
            <Abilities>
                <CharacterAbilityModifyAttackData addeddamagemultiplier="0.1"/>
            </Abilities>
        </AbilityGroupEffect>

        <AbilityGroupEffect abilityeffecttype="OnAttacked">
            <Conditions>
                <AbilityConditionHasAffliction afflictionidentifier="Touhou_Kagiyama_Hina_Character_Effect"/>
                <AbilityConditionHasAffliction afflictionidentifier="Touhou_Misfortune_Curse" minimumPercentage="0.5"/>
            </Conditions>
            <Abilities>
                <CharacterAbilityModifyAttackData addeddamagemultiplier="-0.1"/>
            </Abilities>
        </AbilityGroupEffect>

        <AbilityGroupInterval interval="2.0">
            <Conditions>
                <AbilityConditionHasAffliction afflictionidentifier="Touhou_Kagiyama_Hina_Character_Effect"/>
                <AbilityConditionHasAffliction afflictionidentifier="Touhou_Misfortune_Curse" minimumPercentage="0.5"/>
            </Conditions>
            <Abilities>
                <CharacterAbilityModifyStat stattype="MaximumHealthMultiplier" value="0.15"/>
            </Abilities>
        </AbilityGroupInterval>

        <!-- 「主动释放厄运缠身」改由 Lua 脚本
             Lua/Scripts/Server/Talents/Kagiyama_Hina_Misfortune_Release.lua 实现（东方潜渊行动组Lua补丁）：
             按描述改成「以释放瞬间的厄运缠身强度为准，只打附近敌对目标，并附加长眠不醒的噩梦」，
             不再对 2500 内所有人施加固定数值的 debuff（旧版靠 debuff 内部自清来规避友军，且不含噩梦）。
             以下旧 XML 保留备查。

        <AbilityGroupInterval interval="0.9">
            <Conditions>
                <AbilityConditionHasAffliction afflictionidentifier="Touhou_Kagiyama_Hina_Character_Effect"/>
                <AbilityConditionHasAffliction afflictionidentifier="Touhou_Misfortune_Curse_Release"/>
            </Conditions>
            <Abilities>
                <CharacterAbilityApplyStatusEffects>
                    <StatusEffects>
                        <StatusEffect type="OnAbility" target="NearbyCharacters" range="2500" disabledeltatime="true" >
                            <Affliction identifier="Touhou_Misfortune_Curse_Release_Debuff" amount="10"/>
                        </StatusEffect>
                    </StatusEffects>
                </CharacterAbilityApplyStatusEffects>
            </Abilities>
        </AbilityGroupInterval>
        -->

        <AbilityGroupEffect abilityeffecttype="OnAttack">
            <Conditions>
                <AbilityConditionHasAffliction afflictionidentifier="Touhou_Kagiyama_Hina_Character_Effect"/>
                <AbilityConditionHasAffliction afflictionidentifier="Kagiyama_Hina_Weapons"/>
                <AbilityConditionAboveVitality invert="true" vitalitypercentage="1.0"/>
                <AbilityConditionAttackData tags="Touhou_Magic_Danmu" ignorenonharmfulattacks="true" weapontype="HandheldRanged"/>
            </Conditions>
            <Abilities>
                <CharacterAbilityGiveAffliction affliction="Touhou_Misfortune_Curse" strength="1.0"/>
            </Abilities>
        </AbilityGroupEffect>

        <AbilityGroupEffect abilityeffecttype="OnAttack">
            <Conditions>
                <AbilityConditionHasAffliction afflictionidentifier="Touhou_Kagiyama_Hina_Character_Effect"/>
                <AbilityConditionHasAffliction afflictionidentifier="Kagiyama_Hina_Weapons"/>
                <AbilityConditionAboveVitality invert="true" vitalitypercentage="1.0"/>
                <AbilityConditionAttackData ignorenonharmfulattacks="true" weapontype="Melee"/>
            </Conditions>
            <Abilities>
                <CharacterAbilityGiveAffliction affliction="Touhou_Misfortune_Curse" strength="1.0"/>
            </Abilities>
        </AbilityGroupEffect>

        <AbilityGroupEffect abilityeffecttype="OnAttacked">
            <Conditions>
                <AbilityConditionHasAffliction afflictionidentifier="Touhou_Kagiyama_Hina_Character_Effect"/>
                <AbilityConditionHasAffliction afflictionidentifier="Touhou_Kagiyama_Hina_Character_Effect_OnAttacked_CD" invert="true"/>
                <AbilityConditionAttackData ignorenonharmfulattacks="true"/>
            </Conditions>
            <Abilities>
                <CharacterAbilityApplyStatusEffectsToAttacker>
                    <StatusEffects>
                        <StatusEffect type="OnAbility" target="Character" targetlimb="Torso" delay="0.1" disabledeltatime="true">
                            <Conditional TeamID="None"/>
                            <Conditional TeamID="Team2"/>
                            <Affliction identifier="Touhou_Misfortune_Curse" amount="1.0"/>
                        </StatusEffect>
                    </StatusEffects>
                </CharacterAbilityApplyStatusEffectsToAttacker>
                <!-- 冷却：CharacterAbilityReduceAffliction 走的是 ReduceAfflictionOnAllLimbs，
                     只削减「已存在」的 affliction。而 Touhou_Kagiyama_Hina_Character_Effect_OnAttacked_CD
                     在全模组没有任何地方施加过它（只有这里的 invert 判断与这条削减），
                     所以条件恒成立、2 秒冷却从来没生效过。改成施加：
                     affliction 自身 duration="2.0"，挂上即等于「2 秒冷却」。 -->
                <CharacterAbilityApplyStatusEffects applytoself="true">
                    <StatusEffects>
                        <StatusEffect type="OnAbility" target="Character" disabledeltatime="true">
                            <Affliction identifier="Touhou_Kagiyama_Hina_Character_Effect_OnAttacked_CD" amount="1"/>
                        </StatusEffect>
                    </StatusEffects>
                </CharacterAbilityApplyStatusEffects>
            </Abilities>
        </AbilityGroupEffect>

    </Talent>
</Talents>
